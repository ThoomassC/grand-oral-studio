# Le plus simple : « npm run setup » crée .env depuis ce fichier et génère les secrets.
# À la main : cp .env.example .env, puis compléter.
# Ne jamais versionner .env ni aucun secret (.env* est ignoré par git, sauf ce fichier).
# Minimum pour démarrer en local : DATABASE_URL, TEST_DATABASE_URL, BETTER_AUTH_SECRET.
# En production (Vercel), ces variables sont définies dans le projet Vercel, pas ici.

# PostgreSQL
DATABASE_URL=postgresql://USER@localhost:5432/grand_oral_dev
# Base utilisée par les tests d'intégration (npm run test:int / db:test:migrate)
TEST_DATABASE_URL=postgresql://USER@localhost:5432/grand_oral_test
# Connexions max du pool par instance (défaut 10). En serverless (Vercel), garder bas : 3.
DATABASE_POOL_MAX=

# Better Auth — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
# Adresse publique de l'application : sert aussi aux liens des e-mails (vérification, mot de passe oublié).
BETTER_AUTH_URL=http://localhost:3000

# Connexion avec Google (facultatif) : renseigner les DEUX ou aucun.
# Console Google Cloud → Identifiants → ID client OAuth « Application Web ».
# URI de redirection autorisée à déclarer : http://localhost:3000/api/auth/callback/google
# (en production : <BETTER_AUTH_URL>/api/auth/callback/google). Redémarrer le serveur après modification.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# E-mails (facultatif) via l'API Resend : renseigner les DEUX ou aucune (sinon refus au démarrage).
# Actifs : vérification de l'adresse à l'inscription et « Mot de passe oublié ».
# Vides : ni vérification ni réinitialisation par e-mail (comportement de la 1.1).
# EMAIL_FROM : une adresse d'un domaine vérifié chez Resend, ex. « Grand Oral Studio <noreply@exemple.fr> ».
RESEND_API_KEY=
EMAIL_FROM=
# Domaines autorisés à créer un compte (facultatif), séparés par des virgules, ex. « lycee-exemple.fr, ac-paris.fr ».
# Domaine exact (pas de sous-domaine implicite) ; s'applique aussi à la connexion Google. Vide : aucune restriction.
ALLOWED_EMAIL_DOMAINS=

# En-tête d'IP client posé par VOTRE reverse proxy (un seul nom), ex. :
#   x-real-ip (nginx, Vercel), cf-connecting-ip (Cloudflare), fly-client-ip (Fly.io).
# Indispensable derrière un proxy : sinon un client peut forger x-forwarded-for
# et contourner la limitation de débit de la connexion. Laisser vide en local.
TRUSTED_IP_HEADER=

# Rédaction (choix de chaque utilisateur dans la Rédaction IA) : Claude, Mistral, Gemini, OpenAI
# (avec sa clé ou la clé de l'équipe), Ollama, ou Sans IA. Sans préférence : Claude si une clé
# existe (celle de l'utilisateur, sinon ANTHROPIC_API_KEY), sinon Sans IA, y compris en production.
# AI_PROVIDER=mock (dev/tests uniquement) remplace la clé serveur Claude par le mock déterministe ;
# la clé d'un utilisateur reste prioritaire.
# Toute autre valeur (ex. « ollama ») bloque le démarrage : pour Ollama, utiliser OLLAMA_BASE_URL.
AI_PROVIDER=mock
# Clés de l'équipe (facultatives), une par fournisseur : chaque clé renseignée ajoute le choix
# « clé de l'équipe » pour ce fournisseur dans la Rédaction IA. Facturées au compte de l'équipe,
# soumises aux quotas ci-dessous. Vides : chacun utilise sa propre clé (ou Sans IA).
ANTHROPIC_API_KEY=
# Mistral (console.mistral.ai, offre gratuite disponible, hébergement dans l'UE)
MISTRAL_API_KEY=
# Gemini (aistudio.google.com, offre gratuite disponible)
GEMINI_API_KEY=
# OpenAI (platform.openai.com)
OPENAI_API_KEY=
# URL de l'API Anthropic (https, défaut https://api.anthropic.com). Variable propre à l'app :
# ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN / ANTHROPIC_CUSTOM_HEADERS de l'environnement sont ignorées.
ANTHROPIC_API_URL=
# Modèle Anthropic (défaut : claude-opus-5-5)
AI_MODEL=
# Budget de temps maximal d'un appel de rédaction du diaporama, en ms (défaut 240000)
AI_DECK_TIMEOUT_MS=
# Échéance totale d'une génération du jour J, en ms (défaut 280000, bornée entre 60000 et 295000).
# Une seconde tentative n'est lancée que s'il reste au moins 120 s. Doit tenir dans la durée
# maximale des fonctions de l'hébergeur (maxDuration = 300 s sur les pages qui génèrent).
AI_GENERATION_DEADLINE_MS=
# Quotas d'appels IA par heure : par utilisateur (défaut 80) et pour toute l'application (défaut 600)
AI_QUOTA_PER_HOUR=
AI_GLOBAL_HOURLY_LIMIT=
# Quota par utilisateur quand il génère avec SA clé (défaut 200 ; pas de plafond global)
AI_QUOTA_PER_HOUR_OWN_KEY=

# Ollama (modèle local, facultatif). URL fixée par le SERVEUR, jamais saisie par l'utilisateur.
# Vide = moteur Ollama indisponible. En production, Ollama doit tourner sur le serveur
# (ou un hôte interne), pas sur le poste de l'utilisateur.
OLLAMA_BASE_URL=
# Budget de temps d'un appel Ollama, en ms (défaut 600000 : un modèle local est lent)
AI_OLLAMA_TIMEOUT_MS=
# Budget de temps d'une reconnaissance du thème par Ollama, en ms (défaut 45000 ; au-delà, repli sans IA)
AI_OLLAMA_CLASSIFY_TIMEOUT_MS=
# Quota d'appels Ollama par utilisateur et par heure (défaut 80) et pour toute l'application (défaut 200)
AI_QUOTA_PER_HOUR_OLLAMA=
AI_OLLAMA_GLOBAL_HOURLY_LIMIT=
# Appels Ollama simultanés par instance du serveur (défaut 2) ; au-delà, attente bornée (20 s)
# puis « Le modèle local est occupé, réessayez dans un instant. »
AI_OLLAMA_MAX_CONCURRENCY=

# Clé maître de chiffrement des clés API des utilisateurs (AES-256-GCM).
# Obligatoire pour enregistrer une clé dans la Rédaction IA. 32 octets en base64 :
#   openssl rand -base64 32
# Ne JAMAIS la perdre ni la changer sans rotation : les clés enregistrées deviendraient illisibles.
SETTINGS_ENCRYPTION_KEY=
# Rotation : incrémenter la version, mettre l'ancienne clé dans _PREVIOUS (version - 1).
# Les clés sont rechiffrées avec la nouvelle à leur prochaine lecture ; retirer _PREVIOUS
# une fois toutes les lignes en nouvelle version (SELECT count(*) FROM user_ai_credential WHERE "keyVersion" < N).
SETTINGS_ENCRYPTION_KEY_VERSION=1
SETTINGS_ENCRYPTION_KEY_PREVIOUS=

# Tests E2E Playwright (npm run test:e2e) : serveur de dev déjà lancé.
# URL testée (défaut http://localhost:3000) et base où les comptes e2e-*@example.test sont nettoyés
# (défaut : DATABASE_URL).
E2E_BASE_URL=
E2E_DATABASE_URL=
