# Copier vers .env et compléter. Ne jamais versionner de secret.

# PostgreSQL
DATABASE_URL=postgresql://USER@localhost:5432/grand_oral_dev
# Base utilisée par les tests d'intégration (npm run db:test:migrate)
TEST_DATABASE_URL=postgresql://USER@localhost:5432/grand_oral_test

# Better Auth — générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# IA : "mock" (déterministe, sans réseau) ou "anthropic".
# Sans ANTHROPIC_API_KEY, le mock est utilisé en dev ; en production c'est une erreur.
AI_PROVIDER=mock
ANTHROPIC_API_KEY=
# Modèle Anthropic (défaut : claude-opus-5-5)
AI_MODEL=
