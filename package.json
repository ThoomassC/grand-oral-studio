{
  "name": "grand-oral-studio",
  "version": "1.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "setup": "node scripts/setup.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:validate": "prisma validate",
    "db:studio": "prisma studio",
    "db:test:migrate": "PRISMA_DB=test prisma migrate deploy",
    "postinstall": "prisma generate",
    "test:int": "VITEST_INTEGRATION=1 vitest run --project integration",
    "test:e2e": "playwright test",
    "changelog": "CHANGELOG_WRITE=1 vitest run --project node src/domain/__tests__/changelog.test.ts",
    "vercel-build": "prisma migrate deploy && next build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@thomascaron/opale-ui": "https://github.com/ThoomassC/opale-ui/releases/download/v3.0.4/thomascaron-opale-ui-3.0.4.tgz",
    "better-auth": "^1.7.7",
    "dotenv": "^18.0.5",
    "jszip": "^3.10.2",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "jsdom": "^29.1.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11"
  }
}
