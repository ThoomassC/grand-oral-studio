// Schéma Grand Oral Studio — Prisma 7 (générateur `prisma-client`, driver adapter pg).
// L'URL de connexion est fournie par prisma.config.ts (CLI) et par l'adaptateur (runtime).

generator client {
  provider        = "prisma-client"
  output          = "../src/server/db/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Tables Better Auth (noms et champs alignés sur getAuthTables de @better-auth/core 1.7)
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]
  programs      Program[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
  @@map("verification")
}

/// Compteurs de limitation de débit de Better Auth (rateLimit.storage = "database").
model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt

  @@map("rateLimit")
}

// ---------------------------------------------------------------------------
// Domaine
// ---------------------------------------------------------------------------

model Program {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String   @default("")
  /// BrandSchema (validé par zod à la lecture et à l'écriture)
  brand       Json
  /// PromptTemplateSchema (validé par zod à la lecture et à l'écriture)
  template    Json
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
  themes      Theme[]
  decks       Deck[]

  @@index([ownerId, updatedAt(sort: Desc)])
}

model Theme {
  id          String   @id @default(cuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  /// Ordre d'affichage, 0..n-1. Unique par programme (réordonnancement en deux temps).
  position    Int
  name        String
  description String   @default("")
  keywords    String[] @default([])
  decks       Deck[]

  @@unique([programId, position])
  /// Cible de la clé étrangère composite Deck(themeId, programId) : un deck ne peut
  /// pas pointer vers le thème d'un autre programme.
  @@unique([id, programId])
}

enum DeckKind {
  SKELETON
  FINAL
}

model Deck {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  themeId   String
  theme     Theme    @relation(fields: [themeId, programId], references: [id, programId], onDelete: Cascade)
  kind      DeckKind
  /// Problématique du jour J (decks FINAL uniquement).
  problem   String?
  /// DeckSpecSchema (validé par zod à la lecture et à l'écriture)
  spec      Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  @@index([programId, kind, createdAt(sort: Desc)])
  @@index([themeId])
  /// Au plus un squelette par thème : garanti par la base, pas par le code.
  @@unique([themeId], map: "Deck_one_skeleton_per_theme", where: { kind: "SKELETON" })
}

/// Limitation de débit applicative (appels IA), fenêtre fixe par clé.
model UsageWindow {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int

  @@map("usage_window")
}
